{
  "appId": "com.relay.agent",
  "appName": "Relay",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "backgroundColor": "#F6F7F9",
    "allowMixedContent": true,
    "webContentsDebuggingEnabled": true,
    "adjustMarginsForEdgeToEdge": "disable",
    "resolveServiceWorkerRequests": false
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    }
  }
}
